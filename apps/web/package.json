{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "next build",
    "clean": "git clean -xdf .next .turbo node_modules next-env.d.ts tsconfig.tsbuildinfo",
    "dev": "next dev",
    "format": "prettier . --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:fix": "prettier . --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "lint:arch": "steiger ./src",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "steiger": "catalog:",
    "typescript": "catalog:"
  }
}
