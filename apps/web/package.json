{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "next build",
    "clean": "git clean -xdf .next .turbo node_modules next-env.d.ts tsconfig.tsbuildinfo",
    "dev": "next dev",
    "format": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "lint:arch": "steiger ./src",
    "lint:fix": "eslint . --fix",
    "spell:check": "cspell --no-progress --gitignore --config cspell.json .",
    "start": "next start",
    "test": "vitest run",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "@repo/ui": "workspace:*",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "steiger": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
