# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
.next/
out/
dist/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment files: only the example is committed
.env*
!.env.example

# Deployment
.vercel/

# Certificates
*.pem

# Logs
*.log
npm-debug.log*
.pnpm-debug.log*

# Operating systems
.DS_Store
Thumbs.db

# Editors: only the shared VS Code files are committed
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code: personal settings, and what a session writes while it runs. A worktree
# under .claude/worktrees/ is another checkout of this repository.
.claude/settings.local.json
.claude/orchestration/
.claude/worktrees/
.claude/state/
.claude/sessions/
.claude/memory/
CLAUDE.local.md

# Knowledge graph: graphify writes the graph, its report and the Obsidian notes per
# clone. graphify-out/ is where graphify wrote before 0.17.
.graphify/
graphify-out/

# Obsidian: the shared vault settings are committed, the rest is personal
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
.trash/

# lefthook: personal overrides of lefthook.yml
lefthook-local.yml
