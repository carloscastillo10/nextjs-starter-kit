{
  "name": "next-starter-kit",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf .turbo node_modules",
    "dev": "turbo run dev",
    "format": "turbo run format format:root --continue",
    "format:fix": "turbo run format:fix format:fix:root --continue",
    "format:fix:root": "prettier . --write \"!apps/**\" \"!packages/**\" \"!tooling/**\"",
    "format:root": "prettier . --check \"!apps/**\" \"!packages/**\" \"!tooling/**\"",
    "lint": "turbo run lint lint:root lint:arch --continue",
    "lint:arch": "turbo run lint:arch",
    "lint:fix": "turbo run lint:fix lint:fix:root --continue",
    "lint:fix:root": "eslint \"*.{js,mjs,cjs}\" --fix",
    "lint:root": "eslint \"*.{js,mjs,cjs}\"",
    "test": "turbo run test",
    "types:check": "turbo run types:check"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "prettier": "@repo/prettier-config"
}
