{
  "name": "nextjs-starter-kit",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf .turbo node_modules",
    "dev": "turbo run dev",
    "env:check": "pnpm env:emit && git diff --exit-code .env.example",
    "env:check:turbo": "pnpm --filter @repo/env env:check:turbo",
    "env:emit": "pnpm --filter @repo/env env:emit",
    "format": "turbo run format format:root --continue",
    "format:fix": "turbo run format:fix format:fix:root --continue",
    "format:fix:root": "prettier . --write \"!{apps,packages,tooling}/*/**/*\"",
    "format:root": "prettier . --check \"!{apps,packages,tooling}/*/**/*\"",
    "gates": "node tooling/scripts/gates/run-gates.mjs",
    "graph": "node tooling/scripts/graphify/graph-rebuild.mjs",
    "graph:watch": "graphify watch .",
    "lint": "turbo run lint lint:root lint:arch --continue",
    "lint:arch": "turbo run lint:arch",
    "lint:comments": "node tooling/scripts/comments/check-comments.mjs",
    "lint:fix": "turbo run lint:fix lint:fix:root --continue",
    "lint:fix:root": "eslint \"*.{js,mjs,cjs}\" --fix",
    "lint:frontmatter": "node tooling/scripts/markdown/check-frontmatter.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:root": "eslint \"*.{js,mjs,cjs}\"",
    "spell:check": "turbo run spell:check spell:check:root --continue",
    "spell:check:root": "cspell --no-progress --gitignore --dot . --exclude \"{apps,packages,tooling}/*/**/*\"",
    "test": "turbo run test",
    "types:check": "turbo run types:check"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/types": "catalog:",
    "@repo/spell-check-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/markdown-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/scripts": "workspace:*",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "markdownlint-cli2": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "prettier": "@repo/prettier-config"
}
