{
  "$schema": "./node_modules/markdownlint-cli2/schema/markdownlint-cli2-config-schema.json",
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": [
    "**/node_modules/**",
    ".agents/**",

    // Vendored from other repositories, unlike the skill written here; a worktree is
    // another checkout of this one
    ".claude/skills/!(project-conventions)/**",
    ".claude/worktrees/**",

    // Written and rewritten by `next dev`
    "apps/*/AGENTS.md",
    "apps/*/CLAUDE.md"
  ],
  "config": {
    "extends": "@repo/markdown-config/markdownlint.jsonc"
  }
}
