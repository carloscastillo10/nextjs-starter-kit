{
  "name": "@repo/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "format": "prettier . --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:fix": "prettier . --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
