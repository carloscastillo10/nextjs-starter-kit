{
  "name": "@repo/architecture-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "exports": {
    "./dependency-cruiser": "./dependency-cruiser.config.js",
    "./fsd-roots": "./fsd-roots.js",
    "./steiger": "./steiger.config.js"
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "format": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write --ignore-unknown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spell:check": "cspell --no-progress --gitignore --config cspell.json ."
  },
  "dependencies": {
    "@feature-sliced/steiger-plugin": "catalog:",
    "steiger": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
