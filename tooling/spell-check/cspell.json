{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/dist/**",
    "**/.claude/skills/**",
    "**/.claude/worktrees/**",
    "**/.agents/**",
    "**/.obsidian/**",
    "**/pnpm-lock.yaml",
    "**/skills-lock.json",
    "**/next-env.d.ts",
    "**/*.tsbuildinfo"
  ]
}
