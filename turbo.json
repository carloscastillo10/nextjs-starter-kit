{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [".env.*"],
  "globalEnv": ["APP_ENV", "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"],
  "globalPassThroughEnv": ["CLERK_SECRET_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "lint:arch": {
      "inputs": ["src/**", "steiger.config.ts", "package.json"]
    },
    "//#lint:root": {},
    "//#lint:fix:root": {
      "cache": false
    },
    "format": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.editorconfig",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/tooling/prettier/prettier.config.js"
      ]
    },
    "format:fix": {
      "cache": false
    },
    "//#format:root": {},
    "//#format:fix:root": {
      "cache": false
    },
    "spell:check": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/cspell.json",
        "$TURBO_ROOT$/tooling/cspell/cspell.json",
        "$TURBO_ROOT$/tooling/cspell/project-words.txt"
      ]
    },
    "//#spell:check:root": {},
    "types:check": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
